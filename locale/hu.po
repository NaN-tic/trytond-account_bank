#, python-format
msgctxt "model:ir.message,text:msg_not_compensation"
msgid "Move \"%(move)s\" is not an active compensation move."
msgstr "A(z) „%(move)s” tétel nem aktív kompenzációs tétel."

#, python-format
msgctxt "model:ir.message,text:msg_compensation_in_use"
msgid ""
"Undo the subsequent reconciliation or payment of compensation \"%(move)s\" "
"first."
msgstr ""
"Először vonja vissza a(z) „%(move)s” kompenzációt követő kiegyenlítést vagy "
"fizetést."

#, python-format
msgctxt "model:ir.message,text:msg_compensation_closed_period"
msgid ""
"Compensation \"%(move)s\" cannot be deleted because its period is not open."
msgstr ""
"A(z) „%(move)s” kompenzáció nem törölhető, mert az időszaka nincs nyitva."

#, python-format
msgctxt "model:ir.message,text:msg_compensation_cannot_draft"
msgid ""
"Compensation \"%(move)s\" cannot be deleted because its move cannot be reset"
" to draft."
msgstr ""
"A(z) „%(move)s” kompenzáció nem törölhető, mert a könyvelési tétele nem "
"állítható vissza piszkozatra."
