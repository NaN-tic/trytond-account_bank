#, python-format
msgctxt "model:ir.message,text:msg_not_compensation"
msgid "Move \"%(move)s\" is not an active compensation move."
msgstr "កំណត់ត្រាគណនេយ្យ «%(move)s» មិនមែនជាកំណត់ត្រាកាត់កងសកម្មទេ។"

#, python-format
msgctxt "model:ir.message,text:msg_compensation_in_use"
msgid ""
"Undo the subsequent reconciliation or payment of compensation \"%(move)s\" "
"first."
msgstr ""
"សូមមិនធ្វើការផ្ទៀងផ្ទាត់សមតុល្យ ឬការទូទាត់បន្តបន្ទាប់នៃការកាត់កង «%(move)s» "
"វិញជាមុនសិន។"

#, python-format
msgctxt "model:ir.message,text:msg_compensation_closed_period"
msgid "Compensation \"%(move)s\" cannot be deleted because its period is not open."
msgstr "មិនអាចលុបការកាត់កង «%(move)s» បានទេ ពីព្រោះគ្រារបស់វាមិនកំពុងបើក។"

#, python-format
msgctxt "model:ir.message,text:msg_compensation_cannot_draft"
msgid ""
"Compensation \"%(move)s\" cannot be deleted because its move cannot be reset "
"to draft."
msgstr ""
"មិនអាចលុបការកាត់កង «%(move)s» បានទេ "
"ពីព្រោះការកំណត់ត្រារបស់វាមិនអាចកំណត់ត្រឡប់ទៅជាសេចក្តីព្រាងបាន។"
